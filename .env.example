# Copy this to `.env`, which is where local development values belong. Production credentials
# go in `.env.prod` instead — a name Next does not load implicitly, unlike `.env.production.local`,
# which `npm run build` would pick up.

# This branch's local development database: `db-public` in docker-compose.yml, on 5434 (`db` on
# 5433 is main's). Local Postgres needs no separate pooler, so both URLs point at the same place —
# and must always be changed together.
DATABASE_URL="postgresql://weather:weather@localhost:5434/weather"
DIRECT_URL="postgresql://weather:weather@localhost:5434/weather"

# Shared secret for iOS app authentication
API_KEY=

# Anthropic API key, for generating a haiku per self-crossing intersection
ANTHROPIC_API_KEY=

# Admin CMS password
ADMIN_PASSWORD=

# iron-session secret (32+ char random string)
SESSION_SECRET=
