# Copy this to `.env`, which is where local development values belong. Production credentials
# go in `.env.prod` instead — a name Next does not load implicitly, unlike `.env.production.local`,
# which `npm run build` would pick up.

# The local development database from docker-compose.yml (`npm run db:up`). Local Postgres needs
# no separate pooler, so both URLs point at the same place — and must always be changed together.
DATABASE_URL="postgresql://weather:weather@localhost:5433/weather"
DIRECT_URL="postgresql://weather:weather@localhost:5433/weather"

# Shared secret for iOS app authentication
API_KEY=

# Resend API key (https://resend.com)
RESEND_API_KEY=

# Email notification recipient (hardcoded MVP)
NOTIFICATION_EMAIL=

# Verified sender address, e.g. trace@yourdomain.com
EMAIL_FROM=

# Base URL for generating admin links in emails. Origin only — no path, no trailing
# slash, e.g. https://yourdomain.com
BASE_URL=

# Admin CMS password
ADMIN_PASSWORD=

# Password for the public trace itself, checked by `proxy.ts` via `lib/domain/access.ts`. The gate
# fails closed: leave this unset and nobody reaches `/`, including you. It is a separate secret
# from ADMIN_PASSWORD so the read-only link can be shared without handing over the CMS.
VIEWER_PASSWORD=

# iron-session secret (32+ char random string)
SESSION_SECRET=

# Supabase project URL. The same project holds both buckets, so this is identical in development
# and production — the bucket below is what separates them.
SUPABASE_URL=

# Bucket for image blobs, and the other half of the pairing rule in lib/server/env-guard.ts: the
# local database goes with "intersection-images-dev", the production database with
# "intersection-images", and any crossed pair is refused before it can write. Unset resolves to
# the production bucket, so a development environment must set this explicitly.
SUPABASE_BUCKET="intersection-images-dev"

# Supabase service role key — server-only, never expose to client
# Find under: Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
