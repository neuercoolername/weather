{
  "name": "weather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:up",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:restore": "bash scripts/db-restore.sh",
    "db:psql": "docker compose exec db psql -U weather -d weather",
    "backfill:trace": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-trace.ts",
    "backfill:public-trace": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-public-trace.ts",
    "backfill:public-haikus": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-public-haikus.ts",
    "reset-trace": "tsx --tsconfig tsconfig.scripts.json scripts/reset-trace.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^6.19.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "iron-session": "^8.0.4",
    "next": "16.1.6",
    "node-cron": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
